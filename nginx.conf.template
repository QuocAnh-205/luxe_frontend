server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cho phép upload file (ảnh sản phẩm...) tối đa 10MB qua /api
    client_max_body_size 10m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # DNS nội bộ của Docker, giúp nginx vẫn khởi động được kể cả khi chưa
    # resolve được host backend (vd: backend đang restart)
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Reverse proxy /api/** -> backend:5000/api/** (giữ nguyên path /api/...)
    # "^~" để các URL như /api/uploads/a.png không bị location static (regex) bên dưới bắt mất
    location ^~ /api/ {
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Cho phép React Router (SPA) hoạt động khi reload trang con
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache tài nguyên tĩnh
    location ~* \.(js|css|png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }
}
